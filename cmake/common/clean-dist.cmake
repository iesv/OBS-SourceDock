# Only the dist directory beside this project's CMakeLists.txt may be removed.
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
set(dist_dir "${source_root}/dist")
if(NOT EXISTS "${source_root}/CMakeLists.txt" OR NOT EXISTS "${source_root}/buildspec.json")
  message(FATAL_ERROR "Cannot identify the Source Dock source directory")
endif()
if(IS_SYMLINK "${dist_dir}")
  message(FATAL_ERROR "Refusing to clear a linked dist directory: ${dist_dir}")
endif()
if(EXISTS "${dist_dir}")
  get_filename_component(resolved_dist "${dist_dir}" REALPATH)
  if(NOT IS_DIRECTORY "${dist_dir}" OR NOT "${resolved_dist}" STREQUAL "${dist_dir}")
    message(FATAL_ERROR "Refusing to clear an unexpected dist path: ${dist_dir}")
  endif()
  file(REMOVE_RECURSE "${dist_dir}")
  if(EXISTS "${dist_dir}")
    message(FATAL_ERROR "Could not clear dist: ${dist_dir}")
  endif()
endif()
file(MAKE_DIRECTORY "${dist_dir}")
message(STATUS "Cleared distribution directory: ${dist_dir}")
